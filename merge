#include <iostream>
using namespace std;
void imprimirArray(int* arr, int size) {
    for (int i = 0; i < size; i++) {
        cout << arr[i] << " ";
    }
    cout << endl;
}

void intercambiar(int* a, int* b) {
    int temp = *a;
    *a = *b;
    *b = temp;
}

void merge(int* arr, int size) {
    int* inicio = arr;
    int* mitad = arr + size / 2;
    int* fin = arr + size - 1;
    bool ordenCompleto = false;

    while (!ordenCompleto) {
        ordenCompleto = true;
        for (int* i = inicio; i < fin; i++) {
            if (*i > *(i + 1)) {
                intercambiar(i, i + 1);
                ordenCompleto = false;
            }
        }

        if (fin == mitad) {
            fin = arr + size - 1;
            inicio = arr;
        }
        else {
            fin--;
        }
    }
}

int main() {
    int arr[] = { 9, 1, 8, 2, 7, 3, 6, 4, 5, 0 };
    int size = sizeof(arr) / sizeof(arr[0]);

    cout << "Array original: ";
    imprimirArray(arr, size);

    merge(arr, size);

    cout << "Array ordenado: ";
    imprimirArray(arr, size);

    return 0;
}
